{
  "name": "ceremly",
  "version": "0.1.0",
  "description": "Smart digital invitations and RSVP management for the events that matter — guest management for weddings, graduations, christenings and birthdays.",
  "homepage": "https://ceremly.com",
  "author": "Ceremly",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:convex": "convex dev",
    "typecheck:convex": "convex codegen && tsc --noEmit -p convex/tsconfig.json",
    "test:migration": "vitest run test/migration convex",
    "test:gate:g02": "G02_GATE=live vitest run test/migration/g02-live",
    "test:gate:g03-g05": "tsx scripts/migration/seed-auth-fixture.ts && tsx scripts/migration/export-auth.ts --out .gate/auth-export --fixtures && G03_GATE=live vitest run test/migration/g03-g05-live",
    "test:gate:g06": "vitest run convex/organizations.test.ts convex/auth.test.ts",
    "test:gate:g07": "G07_GATE=live vitest run test/migration/g07-live-billing",
    "test:gate:g08": "vitest run convex/media.test.ts test/migration/storage-bridge-contract.test.ts test/migration/magic-bytes-contract.test.ts",
    "test:gate:g09": "G09_GATE=live vitest run test/migration/security-headers.test.ts && vitest run convex/lib/rateLimit.test.ts convex/auth.test.ts",
    "test:e2e:admin": "ADMIN_E2E=live vitest run test/migration/admin-console-live.test.ts",
    "reconcile:creem": "tsx scripts/migration/reconcile-creem.ts",
    "build:cloudflare": "NUXT_NITRO_PRESET=cloudflare nuxt build",
    "preview:cloudflare": "pnpm build:cloudflare && wrangler dev",
    "deploy:cloudflare:staging": "pnpm build:cloudflare && wrangler deploy --env staging",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "auth:schema": "npx @better-auth/cli generate --config server/utils/auth.ts --output server/database/schema/auth.ts -y",
    "db:generate": "drizzle-kit generate --config ./server/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./server/database/drizzle.config.ts",
    "db:migrate:prod": "NUXT_ENV=prod drizzle-kit migrate --config ./server/database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./server/database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./server/database/drizzle.config.ts",
    "db:seed": "npx tsx server/database/seed/index.ts",
    "db:reset": "npx tsx server/database/seed/reset.ts",
    "verify:rbac": "npx tsx --tsconfig .nuxt/tsconfig.server.json server/database/seed/verify-rbac.ts",
    "verify:isolation-api": "npx tsx --tsconfig .nuxt/tsconfig.server.json server/database/seed/verify-isolation-api.ts",
    "verify:plan-limit": "npx tsx --tsconfig .nuxt/tsconfig.server.json server/database/seed/verify-plan-limit.ts",
    "verify:rate-limit": "npx tsx --tsconfig .nuxt/tsconfig.server.json server/database/seed/verify-rate-limit.ts",
    "verify:account-purge": "npx tsx --tsconfig .nuxt/tsconfig.server.json server/database/seed/verify-account-purge.ts",
    "openapi:generate": "npx tsx scripts/generate-openapi.ts",
    "og:generate": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@creem_io/better-auth": "0.0.13",
    "@creem_io/convex": "0.4.1",
    "@iconify-json/lucide": "^1.2.71",
    "@iconify-json/simple-icons": "^1.2.55",
    "@neondatabase/serverless": "^1.0.2",
    "@nuxt/content": "^3.11.0",
    "@nuxt/fonts": "0.12.1",
    "@nuxt/image": "1.11.0",
    "@nuxt/ui": "^4.1.0",
    "@nuxtjs/i18n": "10.2.0",
    "@nuxtjs/seo": "^3.4.0",
    "@pinia/nuxt": "0.11.3",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.0",
    "@sentry/nuxt": "^10.58.0",
    "@unhead/vue": "^2.1.4",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "@upstash/qstash": "^2.11.0",
    "@upstash/redis": "^1.38.0",
    "@vueuse/core": "^14.0.0",
    "@vueuse/nuxt": "^14.3.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.6.15",
    "better-sqlite3": "^12.6.2",
    "convex": "1.45.0",
    "convex-vue": "0.1.5",
    "creem": "1.9.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.0",
    "nuxt": "^4.2.0",
    "nuxt-security": "2.4.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "resend": "^6.5.2",
    "sharp": "^0.33.5",
    "unstorage": "^1.17.1",
    "uuid": "^13.0.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "convex-test": "0.0.58",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.38.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.1.2",
    "wrangler": "4.131.2",
    "ws": "8.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "nitropack": "2.11.12",
      "drizzle-orm": "^0.45.0",
      "chokidar": "^3.6.0"
    }
  },
  "resolutions": {
    "nitropack": "2.11.12"
  }
}
