# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Setup: cp .env.example .env
#
# Files:
#   - .env       → Local development / dev (gitignored)
#   - .env.prod  → Production deployment (gitignored)
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NUXT_NITRO_PRESET=vercel                         # vercel (serverless) | node-server (self-host)

NUXT_ENV=dev                                     # dev | prod

NUXT_PUBLIC_BASE_URL=http://localhost:3000        # Base URL of your app — NO trailing slash (signed into QStash job URLs)
NUXT_PUBLIC_APP_NAME=YourSaaSName
NUXT_PUBLIC_TWITTER_HANDLE=                        # Optional: e.g. @yourhandle (twitter:site meta)
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=                      # Optional: analytics domain; if empty the script is not loaded
NUXT_PUBLIC_PLAUSIBLE_WEBSITE_ID=                 # Optional: DataFast/Plausible website id
NUXT_PUBLIC_APP_NOTIFY_EMAIL=noreply@example.com
NUXT_PUBLIC_APP_CONTACT_EMAIL=contact@example.com
NUXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com     # Email titolare/privacy mostrata nelle pagine legali (default: privacy@ceremly.com)
NUXT_PUBLIC_LEGAL_EMAIL=legal@example.com         # Email contatto legale (ToS/DPA) mostrata nelle pagine legali (default: legal@ceremly.com)
NUXT_PUBLIC_SENTRY_DSN=                            # Optional: Sentry error tracking DSN (empty = Sentry off). Free tier: https://sentry.io
NUXT_CONTACT_ADMIN_EMAIL=admin@example.com

# Site Mode: waitinglist | active | maintenance
NUXT_PUBLIC_SITE_MODE=active

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Generate secure secret: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long

# Google OAuth
NUXT_GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
NUXT_GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-here

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Neon Postgres — usa due endpoint:
#   - POOLED   (host con "-pooler"): runtime serverless via neon() HTTP. Tollera connessioni effimere.
#   - UNPOOLED (host senza "-pooler"): drizzle-kit (migrazioni/DDL) e pnpm db:reset. Il DDL richiede sessione diretta.
# Dev: crea una branch Neon dedicata. neon() parla HTTPS → NON si connette a un Postgres TCP locale.
NUXT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
NUXT_DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require

# ------------------------------------------------------------------------------
# Admin API (for external admin panel)
# ------------------------------------------------------------------------------
NUXT_ADMIN_API_KEY=your-secure-api-key-here      # Required for /api/admin/* endpoints

# ------------------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------------------
NUXT_RESEND_API_KEY=re_your_resend_api_key_here
# Webhook Resend (firma Svix). Ottenuto da `resend webhooks create` o dashboard. Sensitive.
NUXT_RESEND_WEBHOOK_SECRET=whsec_xxx
# From per inviti/reminder eventi: sottodominio con tracking ON (open+click).
# Transazionali restano su NUXT_PUBLIC_APP_NOTIFY_EMAIL (tracking OFF).
NUXT_PUBLIC_APP_EVENTS_NOTIFY_EMAIL="Ceremly <inviti@events.ceremly.com>"

# ==============================================================================
# CREEM PAYMENT PROVIDER
# ==============================================================================
# Dashboard: https://creem.io/dashboard
# Webhook URL: {APP_URL}/api/auth/creem/webhook (auto-registered by Better Auth plugin)
# Docs: https://docs.creem.io
# ------------------------------------------------------------------------------

NUXT_CREEM_API_KEY=creem_your_api_key_here
NUXT_CREEM_WEBHOOK_SECRET=whsec_your_creem_webhook_secret_here

# Creem Product IDs (from Products page). Due prodotti:
#  - Celebrazione: one-time, per-evento (3900 cent EUR)
#  - Atelier: recurring monthly, sales-led (2400 cent EUR/mese)
NUXT_CREEM_PRODUCT_ID_CELEBRATION=prod_celebration_id
NUXT_CREEM_PRODUCT_ID_ATELIER=prod_atelier_id

# ==============================================================================
# CLOUDFLARE R2 STORAGE
# ==============================================================================
# Dashboard: https://dash.cloudflare.com → R2 Object Storage
# API Tokens: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
# Public URL: bucket settings → Custom Domains or r2.dev subdomain
# ------------------------------------------------------------------------------

NUXT_CF_ACCOUNT_ID=your-cloudflare-account-id
NUXT_CF_ACCESS_KEY_ID=your-r2-access-key-id
NUXT_CF_SECRET_ACCESS_KEY=your-r2-secret-access-key
NUXT_CF_R2_BUCKET_NAME=your-bucket-name
NUXT_CF_R2_PUBLIC_URL=https://cdn.yourdomain.com

# ==============================================================================
# BACKGROUND JOBS (Upstash QStash) + VERCEL CRON
# ==============================================================================
# Dashboard: https://console.upstash.com/qstash
# QStash delivers jobs over HTTP to {NUXT_PUBLIC_BASE_URL}/api/jobs/* and auto-retries.
# Job execution modes:
#   - prod: token set → publish to QStash cloud (delivers to your base URL).
#   - local dev, token empty → jobs run in-process (no HTTP/signature path).
#   - local dev, token set → publishes to cloud, but the cloud cannot reach
#     localhost, so jobs are NOT delivered in dev (expected). Leave the token empty
#     in dev to exercise the in-process fallback.
# ------------------------------------------------------------------------------
NUXT_QSTASH_TOKEN=                               # publish jobs (empty in local dev → in-process fallback)
NUXT_QSTASH_CURRENT_SIGNING_KEY=                 # verify job signature (HMAC)
NUXT_QSTASH_NEXT_SIGNING_KEY=                    # verify job signature during key rotation
NUXT_QSTASH_URL=                                 # empty → cloud QStash endpoint (override only to point publish elsewhere)

# Vercel Cron: /api/cron/* routes accept the platform header `x-vercel-cron` or
# `Authorization: Bearer ${CRON_SECRET}`. NOTE: Vercel sends that Bearer ONLY if the
# project has an env named exactly CRON_SECRET (no NUXT_ prefix) — to use the Bearer
# path, set BOTH CRON_SECRET and NUXT_CRON_SECRET to the same value on the deployment.
NUXT_CRON_SECRET=your-cron-secret-min-16-chars

# ==============================================================================
# UPSTASH REDIS (HTTP cache — Better Auth secondaryStorage on serverless)
# ==============================================================================
# Dashboard: https://console.upstash.com/redis (Global database → REST API)
# Required when NUXT_NITRO_PRESET=vercel (ioredis TCP is not usable on serverless).
# ------------------------------------------------------------------------------
NUXT_UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
NUXT_UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
